{
  "title": "Coliseum",
  "uid": "coliseum",
  "tags": [
    "coliseum"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "API - RED",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 100
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests / s by route",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{service_name=\"coliseum-api\"}[1m]))",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx ratio",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "(sum(rate(http_server_request_duration_seconds_count{service_name=\"coliseum-api\",http_response_status_code=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_server_request_duration_seconds_count{service_name=\"coliseum-api\"}[5m])), 0.001)",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"coliseum-api\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"coliseum-api\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"coliseum-api\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "row",
      "title": "Queue and worker - USE",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "id": 101
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Battles submitted vs processed / min",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "(sum(rate(coliseum_battles_submitted_total[1m])) or vector(0)) * 60",
          "legendFormat": "submitted"
        },
        {
          "expr": "sum by (result) (rate(coliseum_battles_processed_total[1m])) * 60",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Submission to settlement p95",
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(coliseum_battle_queue_latency_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Stream length / pending / DLQ / running",
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "max(coliseum_queue_length) or vector(0)",
          "legendFormat": "length"
        },
        {
          "expr": "max(coliseum_queue_pending) or vector(0)",
          "legendFormat": "pending"
        },
        {
          "expr": "max(coliseum_dlq_length) or vector(0)",
          "legendFormat": "dlq"
        },
        {
          "expr": "max(coliseum_scheduler_running) or vector(0)",
          "legendFormat": "running"
        }
      ]
    },
    {
      "type": "row",
      "title": "Game economy",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "id": 102
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Resources stolen / min",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "(sum by (resource) (rate(coliseum_resources_stolen_total[1m]))) * 60",
          "legendFormat": "{{resource}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Turns per battle (avg)",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "(sum(rate(coliseum_battle_turns_sum[5m])) or vector(0)) / clamp_min(sum(rate(coliseum_battle_turns_count[5m])), 0.001)",
          "legendFormat": "avg turns"
        }
      ]
    }
  ],
  "description": "RED of the API, USE of the queue and the game economy. Rate panels need ~1 minute of traffic (rate over 1m/5m windows); stat panels update within 15 s."
}