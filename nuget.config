<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-level NuGet sources. <clear/> removes any machine-level source so every clone (dev, CI, Docker)
  resolves packages from exactly the same place. Required by Central Package Management (NU1507).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
