<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    HTTP host: Minimal APIs, JWT auth + API-key exchange, rate limiting, ProblemDetails,
    OpenAPI + Scalar UI, SignalR hub with Redis backplane, serves the static clients.
    Program.cs is composition only: no business logic lives here.
  -->
  <PropertyGroup>
    <RootNamespace>Coliseum.Api</RootNamespace>
    <UserSecretsId>coliseum-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Coliseum.Application/Coliseum.Application.csproj" />
    <ProjectReference Include="../Coliseum.Infrastructure.Redis/Coliseum.Infrastructure.Redis.csproj" />
    <ProjectReference Include="../Coliseum.ServiceDefaults/Coliseum.ServiceDefaults.csproj" />
    <ProjectReference Include="../Coliseum.Contracts/Coliseum.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
  </ItemGroup>

  <ItemGroup>
    <!-- Static clients (mini-game + back-office) are plain HTML/JS kept under /clients and served by the API -->
    <Content Include="../../clients/arena-autoplay/**" Link="wwwroot/arena/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../clients/backoffice/**" Link="wwwroot/backoffice/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Coliseum.IntegrationTests" />
  </ItemGroup>
</Project>
